<Project>

	<!--
	  Shared by every project in the repository. MSBuild imports this before each .csproj body, so everything
	  here is a default the project can still override: Weequery.Benchmarks targets one framework rather than
	  two, and neither it nor Tests wants a documentation file.

	  What moved here is what was written out eight or nine times before it was: the frameworks, the nullable and
	  analyzer settings, the version, and the package metadata that belongs to the repository rather than to any
	  one package. What stayed behind is what actually differs between them, which is a Description, a set of
	  PackageTags, and the references.
	-->

	<!--
	  Not for the project BenchmarkDotNet generates to run each job in. It is written under Weequery.Benchmarks\bin,
	  so it imports this file too, and it names its framework with the singular TargetFramework, which a plural
	  one set here would override: the job would restore for net8.0 against a project that only targets net10.0.
	-->
	<PropertyGroup Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!--
	  One line to bump for a release rather than seven that have to agree. The release workflow passes
	  -p:Version from the tag, and a global property beats this, so a tagged build still takes its version from
	  the tag and a local build takes it from here.
	-->
	<PropertyGroup>
		<Version>3.1.0</Version>
	</PropertyGroup>

	<!--
	  PackageId and Title were each the project's own name spelled out again. MSBuildProjectName is that name
	  already, so a package added later is identified and titled without anyone remembering to say so.
	-->
	<PropertyGroup>
		<PackageId>$(MSBuildProjectName)</PackageId>
		<Title>$(MSBuildProjectName)</Title>
		<Authors>Rene Voisin</Authors>
		<Copyright>&#169;2026 MacLean Engineering &amp; Marketing Co. Ltd.</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>maclean_128x128.png</PackageIcon>
		<RepositoryUrl>https://github.com/rvoisin-mcl/Weequery</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
	</PropertyGroup>

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>Recommended</AnalysisMode>
	</PropertyGroup>

	<!--
	  The trim and AOT analyzers are on, and every package is clean under them. That does not mean Weequery works
	  in a trimmed or a Native AOT application unannounced: reaching a property by the name a request happens to
	  carry is what the library is for, and a trimmer deciding what to keep before the request exists cannot know
	  the answer. Clean means that every API where that matters says so, through RequiresUnreferencedCode or
	  RequiresDynamicCode, so a caller is told when they build rather than when they run. See Weequery/AotMessages.cs.

	  Tests and Benchmarks turn this off: neither ships, and neither is worth annotating to prove it.
	-->
	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<!--
	  Every package carried the same licence, and each one said so for itself. The icon is here for the same
	  reason and has to be: PackageIcon names a file inside the package rather than a path on disk, so the
	  property above is only half of it and a package setting one without packing the other is refused outright.
	-->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildThisFileDirectory)maclean_128x128.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
