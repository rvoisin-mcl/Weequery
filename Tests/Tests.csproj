<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- xunit.v3 test projects are self-executing -->
        <OutputType>Exe</OutputType>
        <!-- net8.0 would otherwise default to an older C#, and these tests use expression trees the newer one allows -->
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
        <!-- Npgsql does not follow EF Core's patch numbers and its 8.x line ends at 8.0.11. Asking for more resolves UP to 9.x, which drags EF Core 9 in beside the 8.x providers and every DbContext then throws TypeLoadException -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Weequery\Weequery.csproj" />
        <ProjectReference Include="..\Weequery.AutoMapper\Weequery.AutoMapper.csproj" />
        <ProjectReference Include="..\Weequery.Elasticsearch\Weequery.Elasticsearch.csproj" />
        <ProjectReference Include="..\Weequery.OData\Weequery.OData.csproj" />
        <ProjectReference Include="..\Weequery.Mapster\Weequery.Mapster.csproj" />
        <ProjectReference Include="..\Weequery.Mapperly\Weequery.Mapperly.csproj" />
        <ProjectReference Include="..\Weequery.EntityFrameworkCore\Weequery.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
