<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- Nothing here is public API, so there is no documentation file to want and no CS1591 to answer -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Recommended is for what ships; test code says ToUpper() and means it, see Directory.Build.props -->
        <AnalysisMode>Default</AnalysisMode>
    <IsAotCompatible>false</IsAotCompatible>
        <!-- xunit.v3 test projects are self-executing -->
        <OutputType>Exe</OutputType>
        <!-- The newest C# on every target, since these tests use expression trees the newer language allows -->
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Npgsql does not follow EF Core's patch numbers, so its version is the newest of its own line rather than a match -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Weequery\Weequery.csproj" />
        <ProjectReference Include="..\Weequery.AutoMapper\Weequery.AutoMapper.csproj" />
        <ProjectReference Include="..\Weequery.Elasticsearch\Weequery.Elasticsearch.csproj" />
        <ProjectReference Include="..\Weequery.OData\Weequery.OData.csproj" />
        <ProjectReference Include="..\Weequery.Mapster\Weequery.Mapster.csproj" />
        <ProjectReference Include="..\Weequery.Mapperly\Weequery.Mapperly.csproj" />
        <ProjectReference Include="..\Weequery.EntityFrameworkCore\Weequery.EntityFrameworkCore.csproj" />
    </ItemGroup>

</Project>
