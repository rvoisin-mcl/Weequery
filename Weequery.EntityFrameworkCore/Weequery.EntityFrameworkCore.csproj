<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Checks a Weequery binding list against an EF Core model before any query is built, so a path nothing maps is a startup failure rather than a translation error on the first request that names it. Adds ValidateBindings to DbContext.</Description>
		<PackageTags>weequery;efcore;entity-framework-core;validation;bindings;iqueryable;model</PackageTags>
		<PackageReleaseNotes>
Targets .NET 10 and .NET 11, referencing EF Core 10.0.15 and 11.0.0; .NET 8 is no longer supported. Requires Weequery 3.2.0.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Weequery\Weequery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
