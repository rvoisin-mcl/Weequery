<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Checks a Weequery binding list against an EF Core model before any query is built, so a path nothing maps is a startup failure rather than a translation error on the first request that names it. Adds ValidateBindings to DbContext.</Description>
		<PackageTags>weequery;efcore;entity-framework-core;validation;bindings;iqueryable;model</PackageTags>
		<PackageReleaseNotes>
First release. Adds ValidateBindings to DbContext, which checks a Weequery binding list against the EF Core
model before any query is built, so a path nothing maps is a startup failure rather than a translation error on
the first request that happens to name it. Requires Weequery 3.0.0.
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Weequery\Weequery.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
