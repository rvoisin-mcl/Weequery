<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Dynamic filtering, sorting and paging for IQueryable, driven by data rather than code. A condition built in code, parsed from a compact query language, or deserialized from a client becomes an expression tree and is applied to a query. You declare which properties are filterable, and callers can filter on those and nothing else. Works with EF Core, where conditions become SQL with values passed as parameters, and in memory over the same data. No dependencies.</Description>
		<PackageTags>iqueryable;linq;efcore;entity-framework-core;filtering;sorting;paging;expression-trees;dynamic-query;query-language</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- The test project reaches for helpers that are not part of the published surface -->
		<InternalsVisibleTo Include="Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Packed so it becomes the description on nuget.org, see PackageReadmeFile -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
